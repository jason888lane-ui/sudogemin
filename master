class LiveStripeMonetizationEngine:
    """
    Handles live enterprise payment settlement using the Stripe API.
    """
    def __init__(self):
        self.live_key = os.getenv("STRIPE_LIVE_SECRET_KEY")
        if not self.live_key or not self.live_key.startswith("sk_live_"):
            print("[Stripe Core] WARNING: Valid 'sk_live_...' secret key not detected in env.")
            self.client = None
        else:
            self.client = stripe.StripeClient(self.live_key)
            print("[Stripe Core] LIVE MODE INITIALIZED. Automated billing ready.")

    def create_live_intent(self, buyer_id: str, amount_usd: float, dataset_id: str, merkle_proof: str) -> Dict[str, Any]:
        if not self.client:
            return {
                "status": "SIMULATED_SUCCESS_KEY_MISSING",
                "amount_usd": amount_usd,
                "merkle_proof": merkle_proof
            }

        amount_cents = int(amount_usd * 100)
        payment_intent = self.client.v1.payment_intents.create(
            params={
                "amount": amount_cents,
                "currency": "usd",
                "description": f"Autonomous B2B Data Purchase: {dataset_id}",
                "metadata": {
                    "buyer_id": buyer_id,
                    "dataset_id": dataset_id,
                    "merkle_proof": merkle_proof,
                    "birth_seed": "12251996"
                },
                "automatic_payment_methods": {"enabled": True}
            }
        )
        return {
            "status": "PAYMENT_INTENT_CREATED",
            "intent_id": payment_intent.id,
            "client_secret": payment_intent.client_secret,
            "livemode": payment_intent.livemode,
            "merkle_proof": merkle_proof
        }


