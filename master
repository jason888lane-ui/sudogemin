@app.get("/quantum/status")
def quantum_status():
    try:
        import cudaq
        return {"available":True,"targets":[t.name for t in cudaq.get_targets()],"purpose":"optional quantum simulation/compute"}
    except Exception: return {"available":False,"fallback":"classical computation","note":"No quantum speedup is claimed."}
@app.post("/quantum/bell-sample")
def quantum_sample(shots:int=1000,user=Depends(current_user)):
    if not 100<=shots<=100000: raise HTTPException(422,"shots must be between 100 and 100000.")
    try:
        import cudaq
        @cudaq.kernel
        def bell():
            q=cudaq.qvector(2);cudaq.h(q[0]);cudaq.cx(q[0],q[1]);cudaq.mz(q)
        cudaq.set_target(os.getenv("CUDAQ_TARGET","qpp-cpu"))
        counts={str(k):int(v) for k,v in cudaq.sample(bell,shots_count=shots).items()}
        if sum(counts.values())!=shots: raise RuntimeError("shot count invariant")
        return {"target":os.getenv("CUDAQ_TARGET","qpp-cpu"),"shots":shots,"counts":counts,
            "ideal_bell_support":["00","11"],"note":"No quantum advantage is claimed; noisy hardware can produce other outcomes."}
    except ImportError: raise HTTPException(503,"CUDA-Q is not installed in this environment.")
    except Exception: raise HTTPException(503,"CUDA-Q target or execution unavailable.") from None

