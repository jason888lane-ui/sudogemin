def utcnow(): return datetime.now(timezone.utc)
def canonical(value:Any)->bytes:
    return json.dumps(value,sort_keys=True,separators=(",",":"),ensure_ascii=False,allow_nan=False).encode("utf-8")
def sha256(data:bytes)->str: return hashlib.sha256(data).hexdigest()

# Merkle construction: domain-separated leaves/nodes and explicit empty-tree value.
def _leaf(record:dict)->bytes: return hashlib.sha256(b"\x00"+canonical(record)).digest()
def _parent(left:bytes,right:bytes)->bytes: return hashlib.sha256(b"\x01"+left+right).digest()
def merkle_root(records:list[dict])->str:
    if not records: return sha256(b"\x02EMPTY")
    level=[_leaf(record) for record in records]
    while len(level)>1:
        if len(level)%2: level.append(level[-1])
        level=[_parent(level[i],level[i+1]) for i in range(0,len(level),2)]
    return level[0].hex()
def merkle_proof(records:list[dict],index:int)->dict:
    if index<0 or index>=len(records): raise ValueError("record index out of range")
    level=[_leaf(x) for x in records]; cursor=index; siblings=[]
    while len(level)>1:
        if len(level)%2: level.append(level[-1])
        sibling=cursor-1 if cursor%2 else cursor+1
        siblings.append({"side":"left" if cursor%2 else "right","hash":level[sibling].hex()})
        level=[_parent(level[i],level[i+1]) for i in range(0,len(level),2)]
        cursor//=2
    return {"index":index,"siblings":siblings,"root":level[0].hex()}
def verify_merkle_proof(record:dict,proof:dict,expected_root:str)->bool:
    try:
        current=_leaf(record)
        for item in proof["siblings"]:
            sibling=bytes.fromhex(item["hash"])
            current=_parent(sibling,current) if item["side"]=="left" else _parent(current,sibling)
        return hmac.compare_digest(current.hex(),expected_root)
    except Exception: return False

