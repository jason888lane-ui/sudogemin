def health(): return {"status":"ok","database":engine.dialect.name}
@app.get("/security/invariants")
def security_invariants(user=Depends(current_user)):
    return {"tenant_access":"tenant claim is verified and applied to tenant-scoped queries; PostgreSQL RLS adds a database boundary",
        "dataset_integrity":"canonical JSON, domain-separated SHA-256 Merkle root and independent recomputation",
        "billing":"raw-body Stripe signature validation and unique event ID deduplication",
        "rights":"publication eligibility fails closed unless source evidence is reviewed, unexpired and not revoked",
