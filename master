# I. SATURN-CAPRICORN MERKLE CRYPTOGRAPHIC LEDGER
# =============================================================================
class SaturnMerkleLedger:
    """
    Enforces immutable cryptographic integrity across all B2B transactions
    using a Merkle Tree structure seeded with deterministic birth parameters.
    """
    def __init__(self, birth_seed: str = "12251996"):
        self.salt = birth_seed
        self.ledger: List[str] = []

    def _hash_node(self, payload: str) -> str:
        salted_data = f"{self.salt}:{payload}:{time.time()}"
        return hashlib.sha256(salted_data.encode('utf-8')).hexdigest()

    def generate_merkle_root(self, transactions: List[str]) -> str:
        if not transactions:
            return self._hash_node("GENESIS_NODE_EMPTY")

        current_layer = [self._hash_node(tx) for tx in transactions]

        while len(current_layer) > 1:
            next_layer = []
            for i in range(0, len(current_layer), 2):
                left = current_layer[i]
                right = current_layer[i + 1] if i + 1 < len(current_layer) else left
                combined = self._hash_node(left + right)
                next_layer.append(combined)
            current_layer = next_layer

        root_hash = current_layer[0]
        self.ledger.append(root_hash)
        return root_hash


