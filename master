@app.get("/agents")
def list_agents(user=Depends(current_user)):
    return {k:{"purpose":v["system"],"human_approval_required":v["approval"]} for k,v in AGENTS.items()}
@app.post("/agents/{name}/run")
def agent_endpoint(name:str,body:AgentIn,user=Depends(current_user),db:Session=Depends(db_dep)):
    if name not in AGENTS: raise HTTPException(404,"Unknown agent.")
    model,result=run_agent(name,body.context)
    db.add(AgentRun(tenant_id=user["tenant_id"],agent_name=name,model=model,
        input_hash=sha256(canonical(body.context)),output_json=json.dumps(result,ensure_ascii=False,allow_nan=False)))
    db.commit()
    return {"agent":name,"model":model,"result":result,"status":"requires_human_review" if result.get("human_approval_required") else "proposal"}

@app.post("/sources",status_code=201)
def add_source(body:SourceIn,user=Depends(require_roles("seller","tenant_admin")),db:Session=Depends(db_dep)):
    if body.permission_basis not in {"license","written_permission","public_domain","open_data_license"}:
        raise HTTPException(422,"Unsupported permission basis.")
    source=DataSource(tenant_id=user["tenant_id"],name=body.name,source_uri=body.source_uri,
        license_url=body.license_url,license_text=body.license_text,permission_basis=body.permission_basis,
        evidence_hash=sha256(canonical(body.evidence)),expires_at=body.expires_at)
    db.add(source);db.commit();db.refresh(source)
    return {"source_id":source.id,"evidence_sha256":source.evidence_hash,"status":"pending_review",
        "note":"Evidence hash records integrity, not legal authenticity or permission."}
@app.post("/sources/{source_id}/review")
def review_source(source_id:int,body:ReviewIn,user=Depends(require_roles("compliance","tenant_admin")),db:Session=Depends(db_dep)):
    source=db.scalar(select(DataSource).where(DataSource.id==source_id,DataSource.tenant_id==user["tenant_id"]))
    if not source: raise HTTPException(404,"Source not found.")
    if body.approved:
        source.verified_by=user["subject"];source.verified_at=utcnow();source.revoked_at=None
    else:
        source.verified_by=user["subject"];source.revoked_at=utcnow()
    db.commit()
    return {"source_id":source.id,"status":"verified" if body.approved else "revoked","reason":body.reason}
def rights_valid(source):
    return bool(source and source.verified_at and not source.revoked_at and
        (not source.expires_at or source.expires_at>utcnow()))
@app.post("/datasets",status_code=201)
def add_dataset(body:DatasetIn,user=Depends(require_roles("seller","tenant_admin")),db:Session=Depends(db_dep)):
    source=db.scalar(select(DataSource).where(DataSource.id==body.source_id,DataSource.tenant_id==user["tenant_id"]))
    if not source: raise HTTPException(404,"Source not found.")
    data=json.dumps(body.records,ensure_ascii=False,allow_nan=False)
    dataset=Dataset(tenant_id=user["tenant_id"],source_id=source.id,name=body.name,
        records_json=data,record_count=len(body.records),merkle_root=merkle_root(body.records),
        status="pending_publication" if rights_valid(source) else "rights_unverified")
    db.add(dataset);db.commit();db.refresh(dataset)
    return {"dataset_id":dataset.id,"record_count":dataset.record_count,"merkle_root":dataset.merkle_root,"status":dataset.status}
@app.get("/datasets")
def list_datasets(user=Depends(current_user),db:Session=Depends(db_dep)):
    rows=db.scalars(select(Dataset).where(Dataset.tenant_id==user["tenant_id"])).all()
    return [{"id":x.id,"name":x.name,"record_count":x.record_count,"merkle_root":x.merkle_root,"status":x.status} for x in rows]
@app.get("/datasets/{dataset_id}/verify")
def verify_dataset(dataset_id:int,user=Depends(current_user),db:Session=Depends(db_dep)):
    d=db.scalar(select(Dataset).where(Dataset.id==dataset_id,Dataset.tenant_id==user["tenant_id"]))
    if not d: raise HTTPException(404,"Dataset not found.")
    records=json.loads(d.records_json)
    return {"dataset_id":d.id,"integrity_valid":hmac.compare_digest(merkle_root(records),d.merkle_root),
        "stored_root":d.merkle_root,"calculated_root":merkle_root(records)}
@app.get("/datasets/{dataset_id}/eligibility")
def eligibility(dataset_id:int,user=Depends(current_user),db:Session=Depends(db_dep)):
    d=db.scalar(select(Dataset).where(Dataset.id==dataset_id,Dataset.tenant_id==user["tenant_id"]))
    if not d: raise HTTPException(404,"Dataset not found.")
    s=db.scalar(select(DataSource).where(DataSource.id==d.source_id,DataSource.tenant_id==user["tenant_id"]))
    return {"eligible":rights_valid(s),"reason":"verified, unexpired, non-revoked source evidence required","human_publication_approval_required":True}

@app.post("/billing/checkout")
def checkout(body:CheckoutIn,user=Depends(require_roles("buyer","tenant_admin")),db:Session=Depends(db_dep)):
    if not os.getenv("STRIPE_SECRET_KEY") or not os.getenv("STRIPE_PRICE_ID"): raise HTTPException(503,"Stripe is not configured.")
    stripe.api_key=os.environ["STRIPE_SECRET_KEY"]
    sub=db.scalar(select(Subscription).where(Subscription.tenant_id==user["tenant_id"]))
    if not sub:
        customer=stripe.Customer.create(metadata={"tenant_id":user["tenant_id"]},
            idempotency_key="sudogemin-customer-"+user["tenant_id"])
        sub=Subscription(tenant_id=user["tenant_id"],stripe_customer_id=customer.id);db.add(sub);db.commit()
    session=stripe.checkout.Session.create(mode="subscription",customer=sub.stripe_customer_id,
        line_items=[{"price":os.environ["STRIPE_PRICE_ID"],"quantity":1}],
        success_url=body.success_url,cancel_url=body.cancel_url,
        subscription_data={"metadata":{"tenant_id":user["tenant_id"]}},
        idempotency_key="sudogemin-checkout-"+user["tenant_id"]+"-"+str(int(time.time()//60)))
    return {"checkout_url":session.url}
@app.post("/billing/webhook")
async def stripe_webhook(request:Request,db:Session=Depends(db_dep)):
    secret=os.getenv("STRIPE_WEBHOOK_SECRET")
    if not secret: raise HTTPException(503,"Stripe webhook secret is not configured.")
    try: event=stripe.Webhook.construct_event(await request.body(),request.headers.get("stripe-signature",""),secret)
    except Exception: raise HTTPException(400,"Invalid Stripe signature or payload.") from None
    event_id=event["id"];event_type=event["type"];obj=event["data"]["object"]
    if db.get(StripeEvent,event_id): return {"received":True,"duplicate":True}
    sid=obj.get("subscription") or (obj.get("id") if event_type.startswith("customer.subscription.") else None)
    sub=db.scalar(select(Subscription).where(Subscription.stripe_subscription_id==sid)) if sid else None
    if event_type=="checkout.session.completed":
        tenant=(obj.get("metadata") or {}).get("tenant_id") or obj.get("client_reference_id")
        sub=db.scalar(select(Subscription).where(Subscription.tenant_id==str(tenant))) if tenant else None
        if sub:
            sub.stripe_customer_id=obj.get("customer") or sub.stripe_customer_id
            sub.stripe_subscription_id=obj.get("subscription") or sub.stripe_subscription_id
    elif sub and event_type in {"customer.subscription.created","customer.subscription.updated","customer.subscription.deleted","invoice.paid","invoice.payment_failed"}:
        sub.status=("canceled" if event_type.endswith("deleted") else "active" if event_type=="invoice.paid" else
            "past_due" if event_type=="invoice.payment_failed" else obj.get("status","unknown"))
        sub.cancel_at_period_end=bool(obj.get("cancel_at_period_end",False))
        if obj.get("current_period_end"): sub.current_period_end=datetime.fromtimestamp(obj["current_period_end"],timezone.utc)
    db.add(StripeEvent(id=event_id,event_type=event_type))
    try: db.commit()
    except Exception:
        db.rollback()
        if db.get(StripeEvent,event_id): return {"received":True,"duplicate":True}
        raise HTTPException(500,"Webhook state update failed; retry delivery.")
    return {"received":True,"event_type":event_type}
