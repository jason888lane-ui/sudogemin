# II. CUDA-Q QUANTUM MATCHING ENGINE
# =============================================================================
@cudaq.kernel
def quantum_matching_kernel(buyer_weights: list[float], dataset_weights: list[float]):
    """
    CUDA-Q quantum circuit evaluating vector overlap and attribute correlation
    between B2B buyer specifications and available datasets.
    """
    q = cudaq.qvector(len(buyer_weights))
    h(q)

    for i in range(len(buyer_weights)):
        rx(buyer_weights[i], q[i])

    for i in range(len(dataset_weights)):
        ry(dataset_weights[i], q[i])

    for i in range(len(buyer_weights) - 1):
        x.ctrl(q[i], q[i + 1])

    mz(q)


class CUDAQuantumProcessor:
    """
    Executes high-dimensional dataset compatibility evaluations via CUDA-Q.
    """
    def __init__(self, target_backend: str = "nvidia"):
        try:
            cudaq.set_target(target_backend)
            print(f"[CUDA-Q Core] Target successfully initialized: {target_backend}")
        except Exception as e:
            print(f"[CUDA-Q Core] Target set warning: {e}. Falling back to standard execution.")

    def _normalize(self, vector: List[float]) -> List[float]:
        arr = np.array(vector, dtype=np.float32)
        norm = np.linalg.norm(arr)
        if norm == 0:
            return [0.0] * len(vector)
        return ((arr / norm) * 2 * np.pi).tolist()

    def compute_match(self, buyer_weights: List[float], dataset_weights: List[float]) -> float:
        b_vec = self._normalize(buyer_weights)
        d_vec = self._normalize(dataset_weights)

        # Run 1000 measurement shots on cuQuantum simulator
        counts = cudaq.sample(quantum_matching_kernel, b_vec, d_vec, shots_count=1000)
        target_state = "0" * len(b_vec)
        zero_state_counts = counts.get(target_state, 0)

        match_confidence = zero_state_counts / 1000.0
        return float(match_confidence)


